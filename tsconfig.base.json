{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": false,
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@axiom-atlas/shared-types": ["packages/shared-types/src"],
      "@axiom-atlas/ui": ["packages/ui/src"],
      "@axiom-atlas/api-client": ["packages/api-client/src"],
      "@axiom-atlas/configuration": ["packages/configuration/src"]
    }
  }
}
